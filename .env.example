# Author: Dr. Ousmane Barry
# Copy to .env.local and fill in your key
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model. Default is claude-haiku-4-5, the fastest,
# chosen to meet the <5 second requirement. Use claude-opus-4-8 for
# maximum extraction accuracy at higher latency.
# CLAUDE_MODEL=claude-haiku-4-5

# ---- Access control (REQUIRED in production) ----
# When set, every page and /api/verify require HTTP Basic auth (the browser
# shows its login prompt). Username is ignored unless APP_ACCESS_USER is set.
# In production (NODE_ENV=production) without this, /api/verify returns 503.
# APP_ACCESS_PASSWORD=change-me-long-random
# APP_ACCESS_USER=ttb
# Only if an upstream SSO/proxy (e.g. Azure App Service Authentication)
# already restricts who can reach the app:
# ALLOW_UNAUTHENTICATED=true

# ---- Abuse limits (in memory, per server instance; 0 disables) ----
# RATE_LIMIT_PER_MINUTE=60     # per client IP
# DAILY_REQUEST_CAP=2000       # total Anthropic calls per UTC day

# ---- Client IP detection for the rate limit ----
# Auto: Vercel headers on Vercel; 1 proxy hop on Azure App Service.
# TRUST_PROXY_HOPS=1           # count of proxies that append X-Forwarded-For
# CLIENT_IP_HEADER=x-real-ip   # or a header your proxy sets and overwrites
